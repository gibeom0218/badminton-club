# PostgreSQL 연결 문자열
# 형식: postgresql://사용자명:비밀번호@localhost:5432/badminton_db
# 비밀번호는 본인이 알고 있는 PostgreSQL 비밀번호로 바꾸세요.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/badminton_db

# API 서버 포트
PORT=3000

# JWT 서명 키 (운영 환경에서는 긴 랜덤 문자열로 바꾸세요)
JWT_SECRET=change-me-to-a-long-random-secret
